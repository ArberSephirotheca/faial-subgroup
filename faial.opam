# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Static analysis tool for finding bugs in CUDA kernels"
description:
  "Faial is a static analysis tool for finding bugs in CUDA kernels, featuring data-race freedom (DRF) analysis and performance analysis."
maintainer: ["Tiago Cogumbreiro <cogumbreiro@users.sf.net>"]
authors: ["Tiago Cogumbreiro <cogumbreiro@users.sf.net>"]
license: "MIT"
homepage: "https://gitlab.com/umb-svl/faial"
bug-reports: "https://gitlab.com/umb-svl/faial/-/issues"
depends: [
  "ocaml" {>= "5.3"}
  "cmdliner" {>= "1.3.0"}
  "ANSITerminal" {>= "0.8.5"}
  "otoml" {>= "1.0.5"}
  "yojson" {>= "2.2.2"}
  "printbox-text" {>= "0.11"}
  "fpath" {>= "0.7.3"}
  "z3" {>= "4.15.2"}
  "dune" {>= "3.17" & >= "3.17"}
  "ounit" {>= "2.2.7" & with-test}
  "alcotest" {>= "1.9.0" & with-test}
  "odoc" {with-doc}
  "ocamlformat" {dev}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://gitlab.com/umb-svl/faial.git"
